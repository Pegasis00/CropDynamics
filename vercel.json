{
  "installCommand": "python -m pip install -r requirements.txt && cd frontend && npm ci",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,tests/**,gee_scripts/**,saved_crop_ndvi/**,*.ipynb,combined_ndvi.csv,PROJECT_OVERVIEW.md,NOTEBOOK_MAPPING.md,.pytest_cache/**,.playwright-mcp/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
